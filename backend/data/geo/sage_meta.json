{
  "dataset": "SAGE Crop Calendar Dataset (planting and harvest dates), 0.5 degree",
  "citation": "Sacks, Deryng, Foley & Ramankutty 2010, Crop planting dates: an analysis of global patterns, Global Ecology and Biogeography 19, 607-620",
  "doi": "10.1111/j.1466-8238.2010.00551.x",
  "url": "https://sage.nelson.wisc.edu/data-and-models/datasets/crop-calendar-dataset/",
  "license_note": "SAGE: datasets may be freely downloaded; cite Sacks et al. 2010.",
  "resolution_deg": 0.5,
  "grid": {
    "rows": 360,
    "cols": 720,
    "north_edge": 90.0,
    "west_edge": -180.0
  },
  "layers": [
    "plant_start",
    "plant",
    "plant_end",
    "harvest_start",
    "harvest",
    "harvest_end"
  ],
  "units": "day of year (1-365); 0 = no data; an end before a start means the window crosses New Year",
  "values_are": "dataset_estimate: gridded estimates from national and sub-national reports, mostly circa 1990-2000; not a recommendation",
  "extrapolated_note": "cells marked extrapolated exist only in SAGE's filled file",
